SITESENTRY_DATABASE=data/sitesentry.sqlite3
SITESENTRY_REPORT_DIR=reports/out
SITESENTRY_ALLOWED_DOMAINS=
SITESENTRY_API_TOKEN=replace-with-a-long-random-token
SITESENTRY_AUTH_MODE=static_token
SITESENTRY_SINGLE_INSTANCE=true
SITESENTRY_REDIS_URL=
SITESENTRY_REDIS_NAMESPACE=sitesentry
SITESENTRY_MAX_PENDING=16
SITESENTRY_MAX_WORKERS=2
SITESENTRY_RATE_PER_MINUTE=10
SITESENTRY_DAILY_QUOTA=100
SITESENTRY_DAILY_QUOTA_PER_CLIENT=20
SITESENTRY_CONNECT_TIMEOUT=3.05
SITESENTRY_READ_TIMEOUT=7
SITESENTRY_API_URL=http://127.0.0.1:5000

# Optional explanation providers; never required for scan results.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
GROK_MODEL=
